# Demo / build
DATABASE_URL="file:./prisma/dev.db"
WALMART_USE_BROWSER=0
WALMART_ALLOW_FLIPP_FALLBACK=0
STAPLES_CACHE_STALE_HOURS=72

# Walmart live source: rapid (OpenWeb Ninja / RapidAPI) | browser (Playwright)
# Default: rapid when a key is set, else browser.
WALMART_SOURCE=rapid
WALMART_POSTAL_CODE=L4J0A7

# Prefer OpenWeb Ninja direct key (header x-api-key):
# https://app.openwebninja.com/api/realtime-walmart-data
OPENWEBNINJA_API_KEY=

# Or RapidAPI key for the same API product:
# RAPIDAPI_KEY=
# WALMART_RAPID_HOST=real-time-walmart-data1.p.rapidapi.com

# Loblaw / PC Express (No Frills + Wholesale Club). Public web X-Apikey from
# the banner site Network tab. Do not commit the value.
NOFRILLS_API_KEY=
NOFRILLS_SEARCH_URL=https://api.pcexpress.ca/pcx-bff/api/v2/products/search
NOFRILLS_ALLOW_FLIPP_FALLBACK=0
WHOLESALECLUB_BANNER=wholesaleclub
WHOLESALECLUB_STORE_ID=3724

# Sobeys / FreshCo flyer fallback
SOBEYS_POSTAL_CODE=L4J6W7
FRESHCO_POSTAL_CODE=L4J3M8

# MVR Plus Shopify (public products.json / search/suggest.json)
MVR_SHOPIFY_BASE=https://plus.mvrwholesale.com

# Cross-retailer product identity. Auto-link only at/above this (0-1).
ENTITY_MATCH_AUTO_LINK_THRESHOLD=0.85
