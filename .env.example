# Demo / build
# Local SQLite path is relative to prisma/schema.prisma, so this file is prisma/dev.db (gitignored).
# Vercel cannot store accounts in that file. Connect Postgres in the Vercel project
# (Storage → Postgres). The build reads DATABASE_URL, or POSTGRES_PRISMA_URL,
# and uses POSTGRES_URL_NON_POOLING as the direct URL for creating tables.
DATABASE_URL="file:./dev.db"
WALMART_USE_BROWSER=0
WALMART_ALLOW_FLIPP_FALLBACK=0
STAPLES_CACHE_STALE_HOURS=72

# Walmart live source: rapid (OpenWeb Ninja / RapidAPI) | browser (Playwright)
# WALMART_SOURCE=rapid requires OPENWEBNINJA_API_KEY or RAPIDAPI_KEY.
# A blank key does NOT fall back to scraping walmart.ca (PerimeterX).
WALMART_SOURCE=rapid
WALMART_POSTAL_CODE=L4J0A7

# Prefer OpenWeb Ninja direct key (header x-api-key):
# https://app.openwebninja.com/api/realtime-walmart-data
OPENWEBNINJA_API_KEY=

# RapidAPI "Real-Time Walmart Data" — put the key in local .env, never commit it.
RAPIDAPI_KEY=
WALMART_RAPID_HOST=real-time-walmart-data1.p.rapidapi.com

# Loblaw / PC Express (No Frills + Wholesale Club). Public web X-Apikey from
# the banner site Network tab. Leave blank to use the connector fallback.
# An empty value is treated as unset (do not send a blank X-Apikey).
NOFRILLS_API_KEY=
NOFRILLS_SEARCH_URL=https://api.pcexpress.ca/pcx-bff/api/v2/products/search
NOFRILLS_ALLOW_FLIPP_FALLBACK=0
# Optional Cookie header from the banner Network tab. Used on 401/403 retry.
# Do not commit the value. Nightly GitHub Action may set PCX_BOOTSTRAP_BROWSER=1
# so Playwright rewrites cookies when HTTP harvest is not enough.
# PCX_COOKIE=
# PCX_BOOTSTRAP_BROWSER=0
# PCX_PREWARM_COOKIES=0
WHOLESALECLUB_BANNER=wholesaleclub
WHOLESALECLUB_STORE_ID=3724

# Sobeys / FreshCo flyer fallback
SOBEYS_POSTAL_CODE=L4J6W7
FRESHCO_POSTAL_CODE=L4J3M8

# MVR Plus Shopify (public products.json / search/suggest.json)
MVR_SHOPIFY_BASE=https://plus.mvrwholesale.com

# Cross-retailer product identity. Auto-link only at/above this (0-1).
ENTITY_MATCH_AUTO_LINK_THRESHOLD=0.85

# Match inspector is on by default (site nav). Set 0 to disable.
# ALLOW_MATCH_INSPECTOR=0

# Signup verification email (6-digit code, 30 minutes). Do not commit real values.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Royal SASS <signup@example.com>"

# Google Maps Platform key for Places API (New), Geocoding API, and Routes API.
# Server only. Do not prefix with NEXT_PUBLIC. Restrict the key to those three
# APIs and to this server's IP. Set a billing budget in Google Cloud.
# Autocomplete uses a session token. Place IDs are stored. Other Places content
# is refreshed within 30 days. Missing key: search shows an error and manual
# address entry stays available, but geocoding and road routes will not run.
# GOOGLE_MAPS_API_KEY=

# Receipt photo OCR (optional). Pasted receipt text always works without a key.
# Do not use OCR.space's public helloworld key.
# OPENAI_API_KEY=
# OCR_SPACE_API_KEY=
