generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Retailer {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  stores Store[]
  retailerProducts RetailerProduct[]
  rawResponses RawRetailerResponse[]
}

model Store {
  id               String  @id @default(cuid())
  retailerId       String
  externalStoreId  String
  name             String
  address          String?
  city             String?
  postalCode       String?
  lat              Float?
  lng              Float?
  active           Boolean @default(true)
  retailer         Retailer @relation(fields: [retailerId], references: [id])
  priceObservations PriceObservation[]
  rawResponses     RawRetailerResponse[]
  productMappings  ProductMapping[]

  @@unique([retailerId, externalStoreId])
}

model Product {
  id           String  @id @default(cuid())
  genericName  String
  brand        String?
  category     String?
  sizeValue    Float?
  sizeUnit     String?
  upc          String?
  aliases      RestaurantAlias[]
  mappings     ProductMapping[]
  listItems    ShoppingListItem[]
}

model Restaurant {
  id      String @id @default(cuid())
  name    String
  aliases RestaurantAlias[]
  lists   ShoppingList[]
}

model RestaurantAlias {
  id           String @id @default(cuid())
  restaurantId String
  aliasText    String
  productId    String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  product      Product @relation(fields: [productId], references: [id])

  @@unique([restaurantId, aliasText])
}

model RetailerProduct {
  id                 String @id @default(cuid())
  retailerId         String
  externalProductId  String
  name               String
  brand              String?
  packageSize        String?
  upc                String?
  rawMetadata        String? // JSON
  retailer           Retailer @relation(fields: [retailerId], references: [id])
  mappings           ProductMapping[]
  priceObservations  PriceObservation[]

  @@unique([retailerId, externalProductId])
}

model ProductMapping {
  id                 String  @id @default(cuid())
  productId          String
  retailerProductId  String
  storeId            String?
  confidence         String  @default("exact")
  matchMethod        String?
  matchConfidence    Float?
  verified           Boolean @default(false)
  confirmedByUser    Boolean @default(false)
  product            Product @relation(fields: [productId], references: [id])
  retailerProduct    RetailerProduct @relation(fields: [retailerProductId], references: [id])
  store              Store? @relation(fields: [storeId], references: [id])
}

model PriceObservation {
  id                 String   @id @default(cuid())
  storeId            String
  retailerProductId  String
  priceCents         Int
  unitPriceCents     Int?
  currency           String   @default("CAD")
  promoPriceCents    Int?
  availability       String
  confidence         String   // LIVE_VERIFIED | RECEIPT_VERIFIED | MULTI_SOURCE_CONFIRMED | ESTIMATED | UNKNOWN (legacy: exact/estimated/stale)
  checkedAt          DateTime
  sourceUrl          String?
  rawResponseId      String?
  store              Store @relation(fields: [storeId], references: [id])
  retailerProduct    RetailerProduct @relation(fields: [retailerProductId], references: [id])
  rawResponse        RawRetailerResponse? @relation(fields: [rawResponseId], references: [id])
}

model RawRetailerResponse {
  id          String   @id @default(cuid())
  retailerId  String
  storeId     String?
  requestMeta String   // JSON
  bodyJson    String   // JSON
  fetchedAt   DateTime @default(now())
  retailer    Retailer @relation(fields: [retailerId], references: [id])
  store       Store? @relation(fields: [storeId], references: [id])
  observations PriceObservation[]
}

model ShoppingList {
  id           String @id @default(cuid())
  restaurantId String
  name         String
  createdAt    DateTime @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  items        ShoppingListItem[]
  runs         ComparisonRun[]
}

model ShoppingListItem {
  id           String @id @default(cuid())
  listId       String
  productId    String
  quantity     Float
  quantityUnit String
  list         ShoppingList @relation(fields: [listId], references: [id])
  product      Product @relation(fields: [productId], references: [id])
}

/// Cafe customer account. Password is scrypt (`scrypt:salt:hash`), never plaintext.
model Customer {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  sessions     CustomerSession[]
  memberships  BusinessMember[]
}

/// Cafe / restaurant workspace. One owner creates it after their own account exists.
model Business {
  id           String               @id @default(cuid())
  name         String
  businessType String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      BusinessMember[]
  locations    BusinessLocation[]
  transport    TransportSettings?
  routeSnapshots RouteSnapshot[]
}

/// owner may edit locations. waiter and driver may read, not edit.
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  customerId String
  role       String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([businessId, customerId])
  @@index([customerId])
}

/// A branch of a business. Address text from Google is refreshed within 30 days.
/// Place IDs may be kept. Manual addresses are the owner's own text.
model BusinessLocation {
  id                   String   @id @default(cuid())
  businessId           String
  locationName         String
  formattedAddress     String
  streetAddress        String
  city                 String
  province             String
  postalCode           String
  country              String   @default("CA")
  latitude             Float?
  longitude            Float?
  coordinatesFetchedAt DateTime?
  contentFetchedAt     DateTime?
  googlePlaceId        String?
  isPrimary            Boolean  @default(false)
  isDefaultRouteOrigin Boolean  @default(false)
  source               String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([googlePlaceId])
}

model TransportSettings {
  id                      String   @id @default(cuid())
  businessId              String   @unique
  fuelLitresPer100Km      Float    @default(8)
  fuelPricePerLitre       Float    @default(1.6)
  driverHourlyCost        Float    @default(20)
  vehicleCostPerKm        Float?
  useInclusiveVehicleCost Boolean  @default(false)
  parkingCost             Float    @default(0)
  tollCost                Float    @default(0)
  updatedAt               DateTime @updatedAt
  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

/// Frozen route math. Later address edits must not rewrite these rows.
model RouteSnapshot {
  id               String   @id @default(cuid())
  businessId       String
  kind             String
  originLat        Float
  originLng        Float
  originLabel      String
  stopsJson        String
  distanceMeters   Int?
  durationSeconds  Int?
  transportJson    String
  createdAt        DateTime @default(now())
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

/// Pending signup until the emailed code is confirmed. Code is scrypt, not plaintext.
model SignupCode {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  codeHash     String
  expiresAt    DateTime
  attempts     Int      @default(0)
  createdAt    DateTime @default(now())
}

model ComparisonRun {
  id               String   @id @default(cuid())
  listId           String
  selectedStoreIds String   // JSON array
  resultJson       String
  createdAt        DateTime @default(now())
  list             ShoppingList @relation(fields: [listId], references: [id])
}

/// Pairwise identity between two retailer (or receipt) product records.
/// Do not auto-link when matchConfidence < threshold; those stay needs_review.
/// Live staples compare still uses JSON catalogs; this table is the target store.
model ProductMatch {
  id               String   @id @default(cuid())
  leftRetailer     String
  leftProductId    String
  rightRetailer    String
  rightProductId   String
  matchMethod      String
  matchConfidence  Float
  verified         Boolean  @default(false)
  verifiedAt       DateTime?
  decision         String   @default("needs_review") // auto_linked | needs_review | rejected
  explainJson      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([leftRetailer, leftProductId, rightRetailer, rightProductId])
  @@index([decision])
  @@index([verified])
}
